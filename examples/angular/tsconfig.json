{
    // TypeScript 6.0.3, pinned in this app only: the Angular compiler (ngc, the Analog Vite plugin)
    // supports `typescript >=6.0 <6.1`. In dev the adapter's sources compile with the app (the
    // source condition), so they are part of the program.
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "customConditions": ["@fragiola/source"],
        "types": ["node", "vite/client"],
        "allowImportingTsExtensions": true,
        "useDefineForClassFields": false,
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "angularCompilerOptions": {
        "strictTemplates": true,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictStandalone": true,
        "typeCheckHostBindings": true,
        "extendedDiagnostics": {
            "defaultCategory": "error"
        }
    },
    "include": [
        "src/**/*.ts",
        "../../packages/angular/src/**/*.ts",
        "tests",
        "*.config.ts",
        "vite.shared.ts"
    ]
}
