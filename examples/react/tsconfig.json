{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "customConditions": ["development"],
        "types": ["node", "vite/client"],
        "allowImportingTsExtensions": true,
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "include": [
        "src",
        "scripts",
        "tests",
        "e2e",
        "*.config.ts",
        "vite.shared.ts"
    ]
}
