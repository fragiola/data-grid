{
    "name": "@fragiola/data-grid",
    "version": "0.0.0",
    "description": "Headless data grid core: a typed model with commands, axis math and scroll scaling for millions of cells, windows, cell navigation and the engine that binds a grid to the DOM.",
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/data-grid.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/data-grid",
    "sideEffects": false,
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "jsdom": "30.1.1",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
