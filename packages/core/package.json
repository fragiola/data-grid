{
    "name": "@fragiola/data-grid",
    "version": "0.0.0",
    "description": "Headless data grid core: a typed model with commands, axis math and scroll scaling for millions of cells, windows, the engine that binds a grid to the DOM, and opt-in features (sorting, navigation, row selection, cell ranges, the clipboard, the fill handle).",
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/data-grid.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/data-grid",
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./local": {
            "@fragiola/source": "./src/local/index.ts",
            "types": "./dist/local.d.ts",
            "import": "./dist/local.js",
            "default": "./dist/local.js"
        },
        "./sorting": {
            "@fragiola/source": "./src/sorting/index.ts",
            "types": "./dist/sorting.d.ts",
            "import": "./dist/sorting.js",
            "default": "./dist/sorting.js"
        },
        "./navigation": {
            "@fragiola/source": "./src/navigation/index.ts",
            "types": "./dist/navigation.d.ts",
            "import": "./dist/navigation.js",
            "default": "./dist/navigation.js"
        },
        "./row-selection": {
            "@fragiola/source": "./src/row-selection/index.ts",
            "types": "./dist/row-selection.d.ts",
            "import": "./dist/row-selection.js",
            "default": "./dist/row-selection.js"
        },
        "./range": {
            "@fragiola/source": "./src/range/index.ts",
            "types": "./dist/range.d.ts",
            "import": "./dist/range.js",
            "default": "./dist/range.js"
        },
        "./clipboard": {
            "@fragiola/source": "./src/clipboard/index.ts",
            "types": "./dist/clipboard.d.ts",
            "import": "./dist/clipboard.js",
            "default": "./dist/clipboard.js"
        },
        "./fill": {
            "@fragiola/source": "./src/fill/index.ts",
            "types": "./dist/fill.d.ts",
            "import": "./dist/fill.js",
            "default": "./dist/fill.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./local": {
                "types": "./dist/local.d.ts",
                "import": "./dist/local.js",
                "default": "./dist/local.js"
            },
            "./sorting": {
                "types": "./dist/sorting.d.ts",
                "import": "./dist/sorting.js",
                "default": "./dist/sorting.js"
            },
            "./navigation": {
                "types": "./dist/navigation.d.ts",
                "import": "./dist/navigation.js",
                "default": "./dist/navigation.js"
            },
            "./row-selection": {
                "types": "./dist/row-selection.d.ts",
                "import": "./dist/row-selection.js",
                "default": "./dist/row-selection.js"
            },
            "./range": {
                "types": "./dist/range.d.ts",
                "import": "./dist/range.js",
                "default": "./dist/range.js"
            },
            "./clipboard": {
                "types": "./dist/clipboard.d.ts",
                "import": "./dist/clipboard.js",
                "default": "./dist/clipboard.js"
            },
            "./fill": {
                "types": "./dist/fill.d.ts",
                "import": "./dist/fill.js",
                "default": "./dist/fill.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "jsdom": "30.1.1",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
